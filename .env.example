# Скопируй в .env (для локального запуска) или внеси в Environment Variables на Vercel.
# НИКОМУ не показывай реальные значения и не коммить их в git.

# Токен из @BotFather
BOT_TOKEN=1234567890:AAA...your_token_here

# Supabase: Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key...

# Любая случайная строка: защита вебхука от чужих запросов
WEBHOOK_SECRET=pribumay-sam-slozhnuyu-stroku

# Случайная строка для /api/cron (Vercel сам подставит её в Authorization)
CRON_SECRET=i-etalon-drugaya-slozhnaya-stroku

# Адрес твоего проекта на Vercel, например https://kopilka.vercel.app
# Нужен только для npm run set-webhook / check-webhook
VERCEL_URL=https://kopilka.vercel.app
